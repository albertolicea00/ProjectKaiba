# ---------------------------------------------------------------------------
# Godot
# ---------------------------------------------------------------------------
# .godot/ is entirely generated; extension_list.cfg included. Godot rebuilds it on open.
.godot/
*.translation

# NOTE: *.import files are intentionally NOT ignored. In Godot 4 they carry the resource UID.
# Dropping them makes every clone regenerate new UIDs and breaks uid:// references in scenes.

# ---------------------------------------------------------------------------
# Native build artefacts
# ---------------------------------------------------------------------------
*.o
*.os
*.obj
*.dll
*.so
*.dylib
*.a
*.lib
*.exp
*.pdb
build/
native/build/
.sconsign.dblite
.sconf_temp/
config.log
compile_commands.json

# Built libraries live in game/bin/ and are not versioned, but the extension manifest is.
bin/
!game/bin/
game/bin/*
!game/bin/kaiba.gdextension

# ---------------------------------------------------------------------------
# Game data - never commit. Card data and artwork are copyrighted (see DISCLAIMER.md).
# ---------------------------------------------------------------------------
# Ignore the actual assets inside data/, but keep the folder structure
data/**/*.jpg
data/**/*.png
data/**/*.lua
# Audio. The sound set is 46 MB and carries its own licences; it is fetched, not versioned.
# CREDITS.md is the exception - several effects are CC-BY and the attribution has to travel
# with the project, so it is tracked deliberately.
data/**/*.wav
data/**/*.mp3
data/**/*.ogg
# `make data-scripts` clones ProjectIgnis/CardScripts in here, so this is a git working copy of
# its own. Tracking anything inside it would fight the next `git pull`.
data/base/script/
*.cdb
*.pck
*.ydk

# ---------------------------------------------------------------------------
# Android / export
# ---------------------------------------------------------------------------
*.apk
*.aab
*.keystore
export_presets.cfg
game/android/

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
*.sqlite
*.db

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------------------------------------------------------------------------
# IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.code-workspace
*.suo
*.sln
*.csproj
*.user
*.userprefs

# ---------------------------------------------------------------------------
# Custom
# ---------------------------------------------------------------------------
.workspace/*
tools/cardinfo-api/*.json
