#!/usr/bin/env python
"""Project Kaiba - native build.

Produces ../game/bin/libkaiba_core.<platform>.<target>.<arch>.<ext>: a GDExtension that
statically links ocgcore (the EDOPro rules engine), Lua 5.4 and SQLite.

    scons platform=macos   target=template_debug arch=arm64
    scons platform=android target=template_debug arch=arm64
    scons platform=macos   target=template_debug arch=arm64 selftest=yes
    scons platform=macos   target=template_debug arch=arm64 datatest=yes

Compiler flags here are not arbitrary. Read AGENTS.md section 8 before changing any of them.
"""

import os

# ocgcore propagates Lua errors as C++ exceptions. godot-cpp disables exceptions by default,
# which makes ocgcore unbuildable, so force them on before godot-cpp parses its options.
# (AGENTS.md 8.1)
ARGUMENTS.setdefault("disable_exceptions", "no")

# Consumed here, not by godot-cpp. Popping it keeps godot-cpp from warning about an unknown
# variable when the standalone probe is requested.
BUILD_SELFTEST = ARGUMENTS.pop("selftest", "no") == "yes"
BUILD_DATATEST = ARGUMENTS.pop("datatest", "no") == "yes"

env = SConscript("godot-cpp/SConstruct")

OCGCORE_DIR = "vendor/ocgcore"
LUA_DIR = os.path.join(OCGCORE_DIR, "lua")
LUA_SRC_DIR = os.path.join(LUA_DIR, "src")
SQLITE_DIR = "vendor/sqlite3"

# --------------------------------------------------------------------------------------
# Preconditions
# --------------------------------------------------------------------------------------

if not os.path.isfile(os.path.join(OCGCORE_DIR, "ocgapi.h")):
    raise SystemExit("ocgcore submodule is missing or empty. Run: make deps")

if not os.path.isfile(os.path.join(LUA_SRC_DIR, "lua.h")):
    raise SystemExit("Lua submodule (inside ocgcore) is missing or empty. Run: make deps")

# SQLite is vendored, not a submodule: two public-domain files, no build system of its own.
# `make deps` cannot restore them, so point at the right fix.
if not os.path.isfile(os.path.join(SQLITE_DIR, "sqlite3.c")):
    raise SystemExit(
        "SQLite amalgamation is missing from %s. Re-download it from https://sqlite.org/ "
        "and keep %s/VERSION in sync." % (SQLITE_DIR, SQLITE_DIR)
    )

if env.get("disable_exceptions", False):
    raise SystemExit("ocgcore requires C++ exceptions. Build with disable_exceptions=no.")

if env.get("is_msvc", False):
    raise SystemExit("MSVC is not supported yet: the ocgcore/Lua flags below are GCC/Clang style.")

# --------------------------------------------------------------------------------------
# Shared configuration
# --------------------------------------------------------------------------------------

env.Append(CPPPATH=["src", OCGCORE_DIR])

if env["platform"] == "android" and env["arch"] == "arm64":
    # Android 15+ ships 16 KB memory pages. Mirrors ocgcore's own Android.mk.
    env.Append(LINKFLAGS=["-Wl,-z,max-page-size=16384", "-Wl,-z,common-page-size=16384"])

if env["platform"] == "linux":
    env.Append(LINKFLAGS=["-Wl,--no-undefined"])

OBJ_ROOT = os.path.join("build", env["suffix"].lstrip("."))


def build_objects(build_env, sources, subdir, per_file_cxxflags=None):
    """Compile sources into position-independent objects under build/<config>/<subdir>/.

    Keeps object files out of the vendored submodule trees so they stay clean for `git status`.
    """
    per_file_cxxflags = per_file_cxxflags or {}
    objects = []
    for source in sources:
        source_path = str(source)
        stem = os.path.splitext(os.path.basename(source_path))[0]
        target = os.path.join(OBJ_ROOT, subdir, stem)
        extra = per_file_cxxflags.get(os.path.normpath(source_path))
        if extra:
            file_env = build_env.Clone()
            file_env.Append(CXXFLAGS=extra)
            objects.append(file_env.SharedObject(target=target, source=source_path))
        else:
            objects.append(build_env.SharedObject(target=target, source=source_path))
    return objects


# --------------------------------------------------------------------------------------
# Lua 5.4 - compiled as C++, not C
# --------------------------------------------------------------------------------------
#
# ocgcore raises Lua errors through the C++ exception machinery. If Lua is compiled as C,
# lua_error() longjmps past ocgcore's destructors and corrupts the heap. ocgcore detects
# this at runtime and OCG_CreateDuel returns OCG_DUEL_CREATION_INCOMPATIBLE_LUA_API.
# Upstream does the same thing (lua/premake5.lua: compileas "C++").

LUA_EXCLUDED = {
    "lbitlib.c",    # deprecated bit library
    "lcorolib.c",   # coroutines are driven by ocgcore itself
    "ldblib.c",     # debug library: unsafe for card scripts
    "linit.c",      # ocgcore opens the libraries it wants, one by one
    "loadlib.c",    # dynamic library loading: unsafe
    "loslib.c",     # os.*: unsafe
    "ltests.c",     # Lua's own test harness
    "lua.c",        # has main()
    "luac.c",       # has main()
    "lutf8lib.c",   # unused
    "onelua.c",     # single-translation-unit amalgamation; would duplicate everything
}

lua_env = env.Clone()
lua_env["CC"] = lua_env["CXX"]
lua_env.Append(
    CFLAGS=[
        "-x", "c++",
        "-std=c++17",
        "-fexceptions",
        "-fno-rtti",
        # Fixes lua_getlocaledecpoint() on Android; ships with ocgcore.
        "-include", os.path.join(LUA_DIR, "luaconf-customize.h"),
        "-Wno-deprecated",
        "-Wno-unused-parameter",
    ]
)
lua_env.Append(CPPPATH=[LUA_DIR, LUA_SRC_DIR])

lua_sources = [
    source for source in Glob(os.path.join(LUA_SRC_DIR, "*.c"))
    if os.path.basename(str(source)) not in LUA_EXCLUDED
]
if not lua_sources:
    raise SystemExit("No Lua sources found in %s. Run: make deps" % LUA_SRC_DIR)

lua_objects = build_objects(lua_env, lua_sources, "lua")

# --------------------------------------------------------------------------------------
# ocgcore
# --------------------------------------------------------------------------------------
#
# OCGCORE_EXPORT_FUNCTIONS is deliberately NOT defined: ocgcore is linked statically into
# libkaiba_core and called from C++. Exporting its symbols would only widen our ABI surface.

ocg_env = env.Clone()
ocg_env.Append(CXXFLAGS=["-std=c++17", "-fexceptions", "-fno-rtti", "-Wno-unused-parameter"])
ocg_env.Append(CPPPATH=[LUA_DIR, LUA_SRC_DIR])

if env["target"] == "template_release":
    ocg_env.Append(CPPDEFINES=["NDEBUG"])

ocg_per_file = {}
if env["platform"] == "macos":
    # Upstream premake5.lua builds exactly this file without exceptions on macOS:
    #   filter { "system:macosx", "files:processor_visit.cpp" } buildoptions { "-fno-exceptions" }
    # Deviating here risks a macOS-only miscompile in the process dispatcher.
    ocg_per_file[os.path.normpath(os.path.join(OCGCORE_DIR, "processor_visit.cpp"))] = [
        "-fno-exceptions"
    ]

ocg_sources = sorted(str(source) for source in Glob(os.path.join(OCGCORE_DIR, "*.cpp")))
if not ocg_sources:
    raise SystemExit("No ocgcore sources found in %s. Run: make deps" % OCGCORE_DIR)

ocg_objects = build_objects(ocg_env, ocg_sources, "ocgcore", ocg_per_file)

# --------------------------------------------------------------------------------------
# SQLite - compiled as C, unlike Lua
# --------------------------------------------------------------------------------------
#
# Lua is forced through the C++ compiler because ocgcore unwinds through it (AGENTS.md 8.1).
# SQLite has no such constraint: CardDB closes the database handle before any duel exists, so
# no SQLite frame is ever on the stack when ocgcore throws. Building it as C is also what
# upstream tests, and it keeps the amalgamation free of C++ name mangling.
#
# The defines trim the build rather than tune it:
#   SQLITE_OMIT_LOAD_EXTENSION  no dlopen(). A cdb is untrusted content; loading native code
#                               from one would be a remote code execution path.
#   SQLITE_THREADSAFE=1         serialised. CardDB::open may run off the main thread.
#   SQLITE_DEFAULT_MEMSTATUS=0  drops the global allocation counters we never read.
#   SQLITE_OMIT_DEPRECATED      removes the legacy API surface.
#   SQLITE_DQS=0                double-quoted strings are identifiers only, never string
#                               literals. A typo in a column name then fails loudly instead
#                               of silently evaluating to its own text.

sqlite_env = env.Clone()
# godot-cpp leaves CC pointing at the C compiler; unlike lua_env we deliberately do not
# repoint it at CXX.
sqlite_env.Append(
    CPPDEFINES=[
        "SQLITE_OMIT_LOAD_EXTENSION",
        ("SQLITE_THREADSAFE", 1),
        ("SQLITE_DEFAULT_MEMSTATUS", 0),
        "SQLITE_OMIT_DEPRECATED",
        ("SQLITE_DQS", 0),
    ]
)
sqlite_env.Append(CFLAGS=["-Wno-unused-parameter", "-Wno-implicit-fallthrough"])

sqlite_objects = build_objects(sqlite_env, [os.path.join(SQLITE_DIR, "sqlite3.c")], "sqlite")

# --------------------------------------------------------------------------------------
# Project Kaiba sources
# --------------------------------------------------------------------------------------

kaiba_env = env.Clone()
kaiba_env.Append(CXXFLAGS=["-fexceptions"])
kaiba_env.Append(CPPPATH=[SQLITE_DIR])
kaiba_sources = sorted(str(source) for source in Glob("src/*.cpp"))
kaiba_objects = build_objects(kaiba_env, kaiba_sources, "kaiba")

library = env.SharedLibrary(
    target=os.path.join("..", "game", "bin", "libkaiba_core%s%s" % (env["suffix"], env["SHLIBSUFFIX"])),
    source=kaiba_objects + ocg_objects + lua_objects + sqlite_objects,
)
Default(library)

# --------------------------------------------------------------------------------------
# Optional: standalone headless selftest
# --------------------------------------------------------------------------------------
#
# Links ocgcore + Lua without Godot. If this passes but the GDExtension fails, the problem
# is in the Godot binding; if this fails, the problem is in the core build itself.

if BUILD_SELFTEST:
    if env["platform"] == "android":
        raise SystemExit("selftest=yes builds a host executable; drop platform=android.")
    selftest_env = env.Clone()
    selftest_env["LIBS"] = []
    selftest_env.Append(CXXFLAGS=["-fexceptions"])
    if env["platform"] != "windows":
        selftest_env.Append(LIBS=["m"])
    selftest_objects = build_objects(
        selftest_env, ["tools/selftest_main.cpp", "src/core_selftest.cpp"], "selftest"
    )
    selftest = selftest_env.Program(
        target=os.path.join(OBJ_ROOT, "kaiba_selftest"),
        source=selftest_objects + ocg_objects + lua_objects,
    )
    Default(selftest)

# --------------------------------------------------------------------------------------
# Optional: standalone data-layer test
# --------------------------------------------------------------------------------------
#
# Builds a synthetic cdb and a temporary script tree at runtime and checks CardDB's packed
# column decoding and ScriptVFS's resolution against them. No Godot, and no real card data:
# everything it needs it writes itself into a temp directory and deletes afterwards.
#
#   scons platform=macos target=template_debug arch=arm64 datatest=yes
#   ./build/macos.template_debug.arm64/kaiba_data_test

if BUILD_DATATEST:
    if env["platform"] == "android":
        raise SystemExit("datatest=yes builds a host executable; drop platform=android.")
    datatest_env = env.Clone()
    datatest_env["LIBS"] = []
    datatest_env.Append(CXXFLAGS=["-fexceptions"])
    datatest_env.Append(CPPPATH=[SQLITE_DIR])
    if env["platform"] != "windows":
        datatest_env.Append(LIBS=["m"])
    if env["platform"] == "linux":
        # SQLITE_THREADSAFE=1 pulls in pthreads, which glibc does not fold into libc for
        # older toolchains. macOS has them in libSystem.
        datatest_env.Append(LIBS=["pthread"])
    datatest_objects = build_objects(
        datatest_env,
        ["tools/card_data_test_main.cpp", "src/card_db.cpp", "src/script_vfs.cpp"],
        "datatest",
    )
    datatest = datatest_env.Program(
        target=os.path.join(OBJ_ROOT, "kaiba_data_test"),
        source=datatest_objects + sqlite_objects + ocg_objects + lua_objects,
    )
    Default(datatest)
