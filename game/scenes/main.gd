extends Node

## Boot scene.
##
## Two jobs, in this order.
##
## 1. A startup health check. It proves the native toolchain end to end: the GDExtension loads,
##    ocgcore is linked, Lua was compiled as C++, and a duel can be created, scripted and
##    destroyed. It was the Phase 0 exit criterion and it has stayed because it is still the
##    cheapest way to know the core is alive *before* a duel starts rather than three taps in.
##    `make verify` greps this output for "selftest : PASS".
##
## 2. Handing over. Headless, there is nobody to hand over to: it prints the result and quits,
##    which is what every Makefile target that boots this scene expects. Otherwise it gives the
##    screen to `SceneRouter` and shows the menu (ARCHITECTURE.md section 4).

const CORE_CLASS := "KaibaCore"

## Preloaded rather than named as a global class on purpose. `SceneRouter` as a bare identifier
## resolves through `.godot/global_script_class_cache.cfg`, which is generated by an editor
## import; a project run before its first import would fail to parse this file. The path always
## resolves. Same reasoning as the ClassDB lookup below, one layer up.
const SceneRouterScript := preload("res://platform/scene_router.gd")

@onready var _router: SceneRouterScript = $SceneRouter as SceneRouterScript

var _headless: bool = false


func _ready() -> void:
	_headless = DisplayServer.get_name() == "headless" or OS.get_cmdline_args().has("--headless")

	var healthy: bool = _health_check()

	if _headless:
		get_tree().quit(0 if healthy else 1)
		return

	_router.go(SceneRouterScript.MENU)
	if not healthy:
		_router.announce(
			"The native core did not load, so Solo cannot start. "
			+ "Build it with: make host"
		)


## True when the core is present and its selftest passed. Prints the same lines it always has.
func _health_check() -> bool:
	var core: Object = _instantiate_core()
	if core == null:
		return false
	_report_build(core)
	return _report_selftest(core)


## Uses ClassDB rather than `KaibaCore.new()` on purpose: a missing GDExtension would make the
## literal class name a parse error, and we would lose the diagnostic below.
func _instantiate_core() -> Object:
	if not ClassDB.class_exists(CORE_CLASS):
		push_error(
			"%s is not registered. The GDExtension did not load. " % CORE_CLASS
			+ "Check that game/bin/ holds a library matching this platform, then run: make host"
		)
		return null
	return ClassDB.instantiate(CORE_CLASS)


func _report_build(core: Object) -> void:
	var info: Dictionary = core.get_build_info()
	print("[kaiba] platform : %s %s" % [info["platform"], info["arch"]])
	print("[kaiba] compiler : %s" % info["compiler"])
	print("[kaiba] built    : %s" % info["build_date"])

	if not info["exceptions"]:
		push_error(
			"Built without C++ exceptions, but ocgcore raises Lua errors through them. "
			+ "Rebuild with disable_exceptions=no. See AGENTS.md section 8.1."
		)


func _report_selftest(core: Object) -> bool:
	var result: Dictionary = core.run_selftest()
	print("[kaiba] ocgcore  : %s (headers expect %s)" % [result["core_version"], result["expected_version"]])

	if result["ok"]:
		print("[kaiba] selftest : PASS")
		return true

	push_error("[kaiba] selftest FAILED at stage '%s': %s" % [result["stage"], result["detail"]])
	return false
